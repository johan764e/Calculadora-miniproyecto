
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Grids2_JAPD.grid1"
             Title="Calculadora"
             BackgroundColor="#171717">

    <Grid Padding="18"
          RowDefinitions="2*,5*"
          RowSpacing="15">

        <!-- Pantalla -->
        <Entry x:Name="Display"
               Grid.Row="0"
               Placeholder="0"
               FontSize="42"
               TextColor="White"
               PlaceholderColor="Gray"
               BackgroundColor="Transparent"
               HorizontalTextAlignment="End"
               VerticalTextAlignment="End"
               IsReadOnly="True"/>

        <!-- Botones de la calculadora -->
        <Grid Grid.Row="1"
              Padding="5"
              RowSpacing="8"
              ColumnSpacing="8"
              BackgroundColor="#171717">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Primera fila: funciones -->
            <Button Text="AC"
                    Grid.Row="0" Grid.Column="0"
                    BackgroundColor="#666666"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="⌫"
                    Grid.Row="0" Grid.Column="1"
                    BackgroundColor="#666666"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="%"
                    Grid.Row="0" Grid.Column="2"
                    BackgroundColor="#666666"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="/"
                    Grid.Row="0" Grid.Column="3"
                    BackgroundColor="#FF9500"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <!-- Segunda fila -->
            <Button Text="7"
                    Grid.Row="1" Grid.Column="0"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="8"
                    Grid.Row="1" Grid.Column="1"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="9"
                    Grid.Row="1" Grid.Column="2"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="x"
                    Grid.Row="1" Grid.Column="3"
                    BackgroundColor="#FF9500"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <!-- Tercera fila -->
            <Button Text="4"
                    Grid.Row="2" Grid.Column="0"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="5"
                    Grid.Row="2" Grid.Column="1"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="6"
                    Grid.Row="2" Grid.Column="2"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="-"
                    Grid.Row="2" Grid.Column="3"
                    BackgroundColor="#FF9500"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <!-- Cuarta fila -->
            <Button Text="1"
                    Grid.Row="3" Grid.Column="0"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="2"
                    Grid.Row="3" Grid.Column="1"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="3"
                    Grid.Row="3" Grid.Column="2"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="+"
                    Grid.Row="3" Grid.Column="3"
                    BackgroundColor="#FF9500"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <!-- Quinta fila -->
            <Button Text="0"
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="."
                    Grid.Row="4" Grid.Column="2"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

            <Button Text="="
                    Grid.Row="4" Grid.Column="3"
                    BackgroundColor="#FF9500"
                    TextColor="White"
                    CornerRadius="40"
                    Clicked="OnButtonClicked"/>

        </Grid>
    </Grid>
</ContentPage>
